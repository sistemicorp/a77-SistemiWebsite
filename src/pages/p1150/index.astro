---
import Base from '../../layouts/Base.astro';
import ContactNote from '../../components/ContactNote.astro';
import ShopifyOrder from '../../components/ShopifyOrder.astro';
import YouTube from '../../components/YouTube.astro';

const shipping = 'All orders subject to $30CAN Shipping & Handling for US/Canada, Other Zones Inquire';

const models = [
  {
    name: 'P1150D Power Supply w/Display',
    short: 'P1150D',
    price: '$949',
    image: '/images/p1150d-hero.webp',
    alt: 'P1150D with built-in display',
    desc: 'Everything in the P1150, plus a built-in display and front-panel control knob. Fully autonomous operation, does not require a PC.',
    featured: true,
  },
  {
    name: 'P1150 Power Supply',
    short: 'P1150',
    price: '$849',
    image: '/images/p1150-hero.webp',
    alt: 'P1150 power supply',
    desc: 'The original P1150, controlled from the Web App, CLI or Python. The non-display version is suitable for CI and automation environments.',
    featured: false,
  },
];

const seoTitle = 'P1150 Power Profiler & SMU for Battery Current Profiling';
const seoDescription =
  'P1150 and P1150D: power supply and source measurement unit (SMU) for embedded developers. Current measurement from 1µA to 3.2A and battery charging tests.';

const site = 'https://www.sistemi.ca';
const productLd = (name: string, sku: string, price: string, image: string, description: string) => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  sku,
  mpn: sku,
  image: `${site}${image}`,
  description,
  category: 'Electronic test equipment > Power profiler / source measurement unit',
  brand: { '@type': 'Brand', name: 'Sistemi' },
  manufacturer: { '@id': `${site}/#org` },
  offers: {
    '@type': 'Offer',
    url: `${site}/p1150/`,
    priceCurrency: 'CAD',
    price,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@id': `${site}/#org` },
  },
});
const jsonLd = [
  productLd(
    'P1150D Power Supply w/Display',
    'P1150D',
    '949.00',
    '/images/og-p1150d.jpg',
    'Wide dynamic range current measurement power supply with built-in display, for battery current profiling of embedded and IoT devices. Measures 1µA to 3200mA, sources and sinks current (two-quadrant SMU), 0.5V to 17V output.',
  ),
  productLd(
    'P1150 Power Supply',
    'P1150',
    '849.00',
    '/images/p1150-hero.webp',
    'Wide dynamic range current measurement power supply for battery current profiling of embedded and IoT devices, controlled from the Web App, CLI or Python. Suited to CI and automation. Two-quadrant SMU, 1µA to 3200mA.',
  ),
];

const uses = [
  {
    title: 'Battery Current Profiling',
    text: 'See exactly where the charge goes: deep sleep, wake-ups, radio bursts and boot, all in one capture. Turn the profile into projected battery life for your embedded firmware.',
  },
  {
    title: 'Current Measurement',
    text: 'Precise current measurement from 1µA to 3200mA on a single range, with no shunt switching artifacts, so sleep current and active peaks are both accurate.',
  },
  {
    title: 'Programmable Power Supply',
    text: 'A clean, adjustable 0.5V to 17.0V power supply that stands in for the battery, so every test runs at a known, repeatable voltage.',
  },
  {
    title: 'Source Measurement Unit (SMU)',
    text: 'Two-quadrant operation sources and sinks current while measuring it, giving you SMU-style measurements on the developer\'s desktop.',
  },
  {
    title: 'Battery Charging',
    text: 'Because it can sink current, the P1150 can stand in for the battery on a charging circuit and measure the charging current your design delivers.',
  },
  {
    title: 'CI & Automation',
    text: 'Drive it from Python, the CLI or an AI agent (MCP) to catch power regressions in continuous integration and on the lab bench.',
  },
];

const features = [
  {
    title: '7-Decade Range',
    highlight: '1µA to 3200mA',
    before: 'Measure from ',
    after: ' without range settings. Seamlessly profile deep sleep and active states in one view.',
  },
  {
    title: 'Glitch-Free Data',
    highlight: 'no shunt switching',
    before: 'Patented architecture with ',
    after: '. Eliminates measurement artifacts and "burden" voltage spikes.',
  },
  {
    title: 'High-Speed Sampling',
    highlight: '125ksps rate',
    before: '',
    after: ' and 35kHz bandwidth capture fast transients and SMPS pulses missed by standard meters.',
  },
  {
    title: 'Precise Emulation',
    highlight: '0.5V to 17.0V',
    before: 'Output from ',
    after: ' with a sub-1µA noise floor. Resolve currents to 1µA without software averaging.',
  },
  {
    title: 'Auxiliary Inputs',
    highlight: 'two digital (D0, D1) and one analog (A0)',
    before: 'Use the ',
    after: ' auxiliary inputs for triggering and correlating current profiles to firmware actions.',
  },
  {
    title: 'Two-Quadrant Operation',
    highlight: 'SINK and SRC current',
    before: 'Can ',
    after: ' (two quadrant operation). Works like a compact Source Measurement Unit (SMU), so it can also test battery charging circuits.',
  },
];
---

<Base title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <section class="page-head">
    <div class="container intro">
      <div>
        <span class="badge">Most popular</span>
        <h1>P1150D <span class="h1-sub">with Display</span></h1>
        <p class="sub">
          The P1150 is a wide dynamic range current measurement power supply for profiling current of battery
          powered (IoT) devices with deep sleep modes and high current active states. Think of it as a compact
          source measurement unit (SMU) for embedded developers. The P1150D adds a built-in display and
          front-panel control.
        </p>
        <div class="price">
          <div class="amount">$949 <span>CAN</span></div>
          <div class="stock">Inventory Status: In-Stock</div>
          <div class="ship">{shipping}</div>
        </div>
        <div class="btn-row">
          <a class="btn" href="#buy">Buy now</a>
          <a class="btn btn--ghost light" href="/docs/P1150-Product-Brief.pdf">Product Brief (PDF)</a>
          <a class="btn btn--ghost light" href="/p1150/downloads">Downloads</a>
        </div>
      </div>
      <img src="/images/p1150d-hero.webp" alt="P1150D power supply with built-in display and control knob" width="1600" height="1067" class="intro-img" fetchpriority="high" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ContactNote />

      <h2>Choose your model</h2>
      <div class="models">
        {models.map((m) => (
          <article class:list={['model', { featured: m.featured }]}>
            {m.featured && <span class="badge">Most popular</span>}
            <img src={m.image} alt={m.alt} width="1600" height="1067" loading="lazy" />
            <h3>{m.name}</h3>
            <p class="model-desc">{m.desc}</p>
            <div class="model-price">{m.price} <span>CAN</span></div>
            <a class:list={['btn', { 'btn--ghost': !m.featured }]} href="#buy">Buy {m.short}</a>
          </article>
        ))}
      </div>
      <p class="ship-note">{shipping}</p>

      <h2 class="features-title">Key features</h2>
      <div class="features">
        {features.map((f) => (
          <div class="feature">
            <h3>{f.title}</h3>
            <p>{f.before}<strong>{f.highlight}</strong>{f.after}</p>
          </div>
        ))}
      </div>

      <h2 class="features-title">Built for embedded developers</h2>
      <div class="uses">
        {uses.map((u) => (
          <div class="use">
            <h3>{u.title}</h3>
            <p>{u.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="buy" class="section section--dark">
    <div class="container">
      <h2>Order</h2>
      <ShopifyOrder />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>P1150 PC User Interface</h2>
      <div class="gui-points">
        <div>
          <h3>Log-scale plotting</h3>
          <p>
            Plot current on a log scale to see very small currents alongside large ones, from µA sleep current to
            mA radio bursts in the same view, without having to zoom in continuously and lose the scope of the plot.
          </p>
        </div>
        <div>
          <h3>Auxiliary inputs on the same timeline</h3>
          <p>
            The D0 and D1 digital inputs and the A0 analog input are plotted with the current, so you can trigger on
            a firmware action and see exactly what it costs.
          </p>
        </div>
        <div>
          <h3>Logger &amp; Oscilloscope views</h3>
          <p>
            Use the Logger to capture long running profiles, or the Oscilloscope to trigger on repetitive events
            like radio transmits.
          </p>
        </div>
        <div>
          <h3>mAhr battery life estimation</h3>
          <p>
            Specify your battery capacity and type, and the mAhr plot simulates its discharge voltage curve against
            the average current, giving you an estimate of battery life.
          </p>
        </div>
      </div>
      <img src="/images/p1150-gui.png" alt="P1150 user interface: oscilloscope view of battery current profiling with cursors and current, analog and digital channels" width="2121" height="1069" class="shot" loading="lazy" />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>P1150 QuickStart Video</h2>
      <YouTube id="h-2pctuKa1U" title="P1150 QuickStart Video" />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Why is the P1150 Different?</h2>
      <p class="callout">DOES NOT USE FET Switching architecture</p>
      <p>
        If you have tried other current measurement devices you may have seen "artefacts" in the measurement. All
        other current measurement equipment use multiple shunt resistors and FETs to select which shunt resistor to
        use based on the magnitude of the current. Switching between FETs is susceptible to charge injection from the
        Gate-Source capacitance of the FET. That charge injection causes artefacts in the measurement. There is no way
        to fix that. FET switching architectures must also have an algorithm that must "predict" the current in order
        to switch the FET(s) into the right range. Some current profiles can cause such algorithms to "thrash" between
        ranges.
      </p>
      <p><a href="/p1150/faq">More questions? See the FAQ →</a></p>
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 32px; align-items: center; }
  .sub { font-size: 1.15rem; }
  .h1-sub { font-size: 0.5em; font-weight: 700; color: #c9d6dc; white-space: nowrap; }
  .intro-img {
    width: 100%;
    max-width: 620px;
    justify-self: center;
    /* fade the render's soft shadow out to the edges so no box shows */
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at center, #000 70%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at center, #000 70%, transparent 100%);
  }
  .badge {
    display: inline-block;
    background: var(--c-teal);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .models {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin-bottom: 12px;
  }
  .model {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .model.featured { border: 2px solid var(--c-teal); background: linear-gradient(180deg, rgba(74, 159, 177, 0.08), transparent 55%); }
  .model .badge { position: absolute; top: 16px; right: 16px; margin: 0; }
  .model img {
    width: 100%;
    margin-bottom: 16px;
    border-radius: 8px;
    background: radial-gradient(ellipse at center, #2b5d75 0%, var(--c-dark) 75%);
  }
  .model h3 { margin-bottom: 0.3em; }
  .model-desc { color: var(--c-muted); font-size: 0.95rem; }
  .model-price { font-size: 1.8rem; font-weight: 900; color: var(--c-accent); margin: auto 0 14px; }
  .model-price span { font-size: 0.9rem; font-weight: 700; color: var(--c-muted); }
  .ship-note { color: var(--c-muted); font-size: 0.9rem; }
  .features-title { margin-top: 40px; }
  .price { margin-top: 24px; }
  .amount { font-size: 2.2rem; font-weight: 900; color: #fff; }
  .amount span { font-size: 1rem; font-weight: 700; color: #c9d6dc; }
  .stock { color: #7fe0a0; font-weight: 700; }
  .ship { color: #9fb0b8; font-size: 0.9rem; margin-top: 4px; }
  .btn--ghost.light { color: #fff; border-color: rgba(255, 255, 255, 0.6); }
  .btn--ghost.light:hover { background: #fff; color: var(--c-dark); border-color: #fff; }

  .features,
  .uses {
    display: grid;
    grid-template-columns: 1fr; /* phone: one per row */
    gap: 16px;
  }
  @media (min-width: 560px) {
    .features, .uses { grid-template-columns: repeat(2, 1fr); } /* tablet: 3 rows of 2 */
  }
  @media (min-width: 900px) {
    .features, .uses { grid-template-columns: repeat(3, 1fr); } /* desktop: 2 rows of 3 */
  }
  .feature,
  .use {
    background: #fff;
    border: 1px solid var(--c-border);
    border-top: 4px solid var(--c-teal);
    border-radius: var(--radius);
    padding: 18px;
  }
  .use { border-top-width: 1px; background: var(--c-bg-alt); }
  .feature h3, .use h3 { font-size: 1.05rem; }
  .feature p, .use p { margin: 0; color: var(--c-muted); font-size: 0.95rem; }
  .feature strong { color: #367d8c; }

  .gui-points {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px 40px;
    margin-bottom: 28px;
  }
  @media (min-width: 760px) {
    .gui-points { grid-template-columns: repeat(2, 1fr); } /* 2 x 2 */
  }
  .gui-points h3 { font-size: 1.05rem; margin-bottom: 0.3em; }
  .gui-points p { color: var(--c-muted); margin: 0; }
  .shot { width: 100%; border-radius: var(--radius); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); }
  .narrow { max-width: 860px; }
  .callout {
    display: inline-block;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--c-accent);
    background: rgba(30, 108, 147, 0.1);
    padding: 6px 12px;
    border-radius: 6px;
  }

  @media (min-width: 820px) {
    .intro { grid-template-columns: 1.2fr 1fr; }
  }
</style>

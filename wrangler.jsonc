// Cloudflare Workers static-assets deployment.
// Deploy with: npm run deploy   (or connect the GitHub repo in the Cloudflare dashboard)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistemi-website",
  "compatibility_date": "2026-11-01",
  // Serves www.sistemi.ca; Cloudflare creates the DNS record and certificate.
  // Keep the sistemi-website.<subdomain>.workers.dev test address too.
  "workers_dev": true,
  "routes": [
    { "pattern": "www.sistemi.ca", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
